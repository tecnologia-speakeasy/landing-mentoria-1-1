# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git.

# Conexión a Postgres. El schema (?schema=...) se aplica vía search_path.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=agendamiento"

# OpenAI — calificación de preguntas abiertas y generación del feedback.
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4.1-mini"

# ─── Agendamiento ──────────────────────────────────────────────────────────────
APP_TZ="America/Bogota"
BOOKING_DATES="2026-06-29,2026-06-30,2026-07-01,2026-07-02,2026-07-03"
# Rejilla de horarios de 30 min (opcional; por defecto 06:00–22:00 cada 30).
# La disponibilidad real por profesor vive en la tabla agendamiento.disponibilidad.
BOOKING_SLOT_START="06:00"
BOOKING_SLOT_END="22:00"
BOOKING_SLOT_STEP_MIN="30"
# Antelación mínima para agendar (minutos). Un slot se deshabilita si falta
# menos de esto respecto a la hora actual. Por defecto 120 (2 horas).
BOOKING_LEAD_MIN="120"
SESSION_SECRET="cambia-esto-en-produccion"
NOTIFIER="email"             # log | email | whatsapp
MEETING_PROVIDER="zoom"      # placeholder | zoom

# n8n — webhook que se dispara con cada cita para registrarla en el Google Sheet
# del profesor. Si se deja vacío, no se llama a n8n (el resto sigue funcionando).
N8N_WEBHOOK_CITA=""          # ej. https://tu-n8n.com/webhook/cita-agendada
N8N_WEBHOOK_SECRET=""        # opcional: se envía como header x-webhook-secret

# GoHighLevel — URL del trigger "Inbound Webhook" del workflow que envía el
# WhatsApp de confirmación. Si se deja vacío, no se llama a GoHighLevel.
# Probar con: npm run ghl:test -- correo@de.prueba.com
GHL_WEBHOOK_CITA=""

# Correo SMTP (Google Workspace). SMTP_PASS = contraseña de aplicación de Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="notificaciones@tudominio.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Speak Easy <notificaciones@tudominio.com>"

